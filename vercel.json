{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=60" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60" }
      ]
    }
  ],
  "functions": {
    "api/refresh.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/refresh?source=cron",
      "schedule": "30 20 * * *"
    }
  ]
}
